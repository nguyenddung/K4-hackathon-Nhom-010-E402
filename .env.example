# FILE MẪU CÓ THỂ COMMIT - KHÔNG ĐIỀN API KEY THẬT VÀO ĐÂY.
# Chạy: Copy-Item .env.example .env; sau đó chỉ sửa file .env.
# auto: chỉ cần điền MỘT API key (ưu tiên Gemini > Groq > OpenAI)
AI_PROVIDER=auto

# Gemini
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.6-flash
GEMINI_EMBED_MODEL=gemini-embedding-001

# Groq (chat dùng Groq, embedding tự động dùng local)
GROQ_API_KEY=
GROQ_CHAT_MODEL=llama-3.3-70b-versatile

# OpenAI (tùy chọn, giữ để tương thích cấu hình cũ)
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small

# auto | gemini | openai | local
EMBEDDING_PROVIDER=auto
AI_TIMEOUT_SECONDS=60
MAX_OUTPUT_TOKENS=450

# App / PDF
MAX_CV_SIZE_BYTES=8388608
MAX_CV_PAGES=20
MAX_CV_REVISIONS=2
