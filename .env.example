# Required in production: use a long random value, never commit the real secret.
SECRET_KEY=replace-with-a-long-random-secret
TOKEN_TTL_MINUTES=480
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Select one provider for every LLM call in the project: openai, gemini, or groq.
AI_PROVIDER=groq

# Configure the key for the selected provider.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
EMBED_MODEL=text-embedding-3-small
MAX_OUTPUT_TOKENS=2400

# Grounded CV RAG: embeddings run locally; only retrieved/redacted chunks go to the selected LLM.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
LOCAL_EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
